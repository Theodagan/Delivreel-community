{
  "name": "delivreel-clone-frontend",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port ${FRONTEND_PORT:-4200}",
    "start-fb": "ng serve --host 0.0.0.0 --port ${FRONTEND_PORT:-4200} --proxy-config proxy.conf.json",
    "build": "ng build",
    "dev": "ng serve --host 0.0.0.0 --port ${FRONTEND_PORT:-4200}",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand --ci",
    "test:cov": "jest --coverage --runInBand",
    "build:prod": "ng build --configuration production",
    "build:selfhost": "ng build --configuration selfhost",
    "dev:selfhost": "ng serve --host 0.0.0.0 --port ${FRONTEND_PORT:-4200} --configuration selfhost"
  },
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/cdk": "^20.1.6",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/material": "^20.1.6",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "hls.js": "^1.6.10",
    "rxjs": "^7.8.1",
    "socket.io-client": "^4.7.0",
    "tslib": "^2.5.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@types/hls.js": "^0.13.3",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.6.2",
    "jsdom": "^26.1.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.2"
  }
}
